// ═══════════════════════════════════════════════════════════════
// Laclarc on Cloudflare Workers — wrangler.jsonc (MIGRATION-CF v1.2 — phase-abc edition)
// ═══════════════════════════════════════════════════════════════
// الوثيقة الأم: MIGRATION-CF.md (في جذر الريبو) — اقراها قبل ما تخدم هنا.
//
// 🔑 قبل أول deploy لازم تعمّر مكانين في هذا الملف:
//    1) kv_namespaces[0].id → صنعته بـ: npx wrangler kv namespace create NEXT_INC_CACHE_KV
//       (الأمر كيخرج لك id — الصقه في الأسفل)
//    2) d1_databases[0].database_id → صنعته بـ: npx wrangler d1 create laclarc-tag-cache
//       (الأمر كيخرج لك UUID — الصقه في الأسفل)
//
// 📦 واش كيمثل كل binding:
//    NEXT_INC_CACHE_KV        → نسخة edge-cache (edgecache:catalog_version) — ISR واقف ف94
//    NEXT_TAG_CACHE_D1        → كاش الوسوم (revalidateTag) — D1 مجاني 5GB
//    NEXT_CACHE_DO_QUEUE      → طابور إعادة التوليد (revalidate 86400) — DO مجاني
//    ASSETS                   → الملفات الثابتة (/_next/static, sw.js, icons)
//    WORKER_SELF_REFERENCE    → مرجع داخلي كيطلبو OpenNext — ما تلمسوش
//    HYPERDRIVE               → قراءة الكاتالوگ RO (laclarc_ro) — F106
//    MEDIA_BUCKET             → 🆕 phase-abc — R2 laclarc-media: merchant feeds + ملتيميديا مستقبلاً
//                               (الباکت موجود حياً ومؤكد بـ r2_probe — ما كيحتاجش شي إنشاء)
//    STORE_ANALYTICS          → 🆕 phase-abc — Analytics Engine (dataset laclarc_events كيتولد
//                               أوتوماتيكياً عند أول writeDataPoint) — Workers Paid مفعّل حياً
//                               (تأكيد حي: subscriptions/Workers Paid + Analytics Engine API)
// ═══════════════════════════════════════════════════════════════
{
        "$schema": "node_modules/wrangler/config-schema.json",
        // اسم الـ Worker — الرابط التجريبي: https://laclarc.<subdomain>.workers.dev
        "name": "laclarc",
        // 🔴 phase-abc — الـ entry الجديد: غلاف fetch (نفس OpenNext حرفياً) + scheduled
        //    للـ crons الثلاثة — شوف custom-worker.ts. .open-next/worker.js كيبقى كيتولد
        //    كالعادة (cf-build.mjs → opennextjs-cloudflare build → wrangler كيجمع الغلاف).
        "main": "custom-worker.ts",
        "compatibility_date": "2026-11-12",
        // 🛡️ server-only بدون شرط react-server عند wrangler كيحلّه للمدخل اللي كيطرش (throw فـ module scope)
        //    → CI deploy كيترفض بـ code 10021 (درس من build 23:31).
        //    الـ alias كيحوّله لـ shim خاوي — مكافئ حرفياً للـ react-server resolution، وكيسدّ الباب على أي ملف جاي.
        "alias": { "server-only": "./shims/server-only-empty.ts" },
        // 📡 مراقبة الإنتاج — Workers Logs: cron errors وfetch logs كيتشافو مباشرة (من 01:00 UTC tick)
        "observability": {
                "enabled": true,
        },
// ─── ⭐ Workers Cache: CF كيفحص الكاش قبل ما يجري الـ Worker ───
// صفحات ISR (s-maxage=86400) كتخدم من الحافة — HIT = صفر تنفيذ Worker
"cache": {
  "enabled": true,
},
        // ⏱️ ops-fix (2026-11-24) — سقف CPU للـ Worker:
        //    الافتراضي 30s قتَل feeds cron فـ 03:00 UTC (exceededCpu بعد 3m25s wall
        //    على 54,367 منتج → R2 multipart ما اكتملش → feed 404).
        //    الخطة المدفوعة (Workers Paid) تسمح حتى 5min — رفعناه لـ 300000ms.
        "limits": { "cpu_ms": 300000 },
        "compatibility_flags": [
                // Node.js APIs داخل الـ Worker (Buffer, crypto — كيستعملهم /api/revalidate وNextAuth)
                "nodejs_compat",
                // fetch للدومينات العمومية فقط (الباك على Render) — موصى بها من OpenNext
                "global_fetch_strictly_public",
        ],
        // ─── الملفات الثابتة ───
        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS",
        },
        // ─── مرجع داخلي إجباري (يجب أن يطابق "name" فوق) ───
        "ai": {
        "binding": "AI",
    },
    "services": [
                {
                        "binding": "WORKER_SELF_REFERENCE",
                        "service": "laclarc",
                },
        ],
        // ─── كاش ISR (KV) — F#94 KV-BUDGET-2: NS جديد فارغ — الـ ISR cache واقف تماماً
        //     (incrementalCache:"dummy" فـ open-next.config.ts) فالـ binding قاعد بلا خدمة.
        //     الـ NS القديم NEXT_INC_CACHE_KV (c56988e5...) فيه ~20GB كاش قديم بلا TTL —
        //     المالك يحيدو من الداشبورد: Storage & Databases → KV → NEXT_INC_CACHE_KV → Delete ───
        "kv_namespaces": [
                {
                        "binding": "NEXT_INC_CACHE_KV",
                        "id": "3f3af1a3ebdf42df80d0657ce53b58fc",
                        "remote": true,
                },
        ],
        // ─── كاش الوسوم (D1) — ضروري حيت كتستعمل revalidateTag فالـ webhook ───
        "d1_databases": [
                {
                        "binding": "NEXT_TAG_CACHE_D1",
                        "database_name": "laclarc-tag-cache",
                        "database_id": "ef5d0d6a-9e23-473a-89b5-3923516fe0a6",
                },
        ],
        // ─── 🆕 F106 HYPERDRIVE-RO — قراءة الكاتالوگ من Supabase نيشان ───
        // الدور laclarc_ro = SELECT فقط على products/store_settings/categories
        // (بوليسيات RLS ro_select_*) — الكتابة مستحيلة على مستوى الداتابيز.
        //
        // 🔑 قبل أول deploy بالـ binding: اصنع config ودخّل الـ id هنا:
        //    Dashboard: Workers & Pages → Hyperdrive → Connect database
        //      → الاسم: laclarc-ro + الـ connection string (شوف README-F106)
        //    ولا CLI: npx wrangler hyperdrive create laclarc-ro \
        //      --connection-string="postgresql://laclarc_ro.<PROJECT_REF>:<RO_PASSWORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
        //
        // ⚠️ إلا الـ config ما كاينش/الـ id غالط → deploy كيفشل؛ القراءات
        //    كيرجعو للـ API الباك أوتوماتيكياً (سلوك F106 الـ fallback).
        "hyperdrive": [
                {
                        "binding": "HYPERDRIVE",
                        "id": "5ccf5cf2f4d84f0e9bf72eb540b97918",
                        // للـ dev المحلي (wrangler dev) — نفس دور laclarc_ro بلا Hyperdrive.
                        // ⚠️ ماتسحوش للريبو العام — بدل بالقيمة الحقيقية محلياً فقط.
                        "localConnectionString": "postgresql://laclarc_ro.<PROJECT_REF>:<RO_PASSWORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres",
                },
        ],
        // ─── 🆕 phase-abc — MEDIA_BUCKET: R2 laclarc-media (موجود حياً — 2 objects مؤكدين) ───
        // الـ feeds كترفع كل يوم 3:00 UTC → feeds/merchant-feed.xml + feeds/merchant-feed-usd.xml
        // والقراءة العامة عبر route /feeds/[file] (ما كيحتاجش r2.dev public access).
        "r2_buckets": [
                {
                        "binding": "MEDIA_BUCKET",
                        "bucket_name": "laclarc-media",
                },
        ],
        // ─── 🆕 phase-abc — Analytics Engine (البند 9) — Workers Paid مفعّل حياً ───
        // dataset كيتولد أوتوماتيكياً عند أول writeDataPoint — fail-open: أي فشل
        // ما كيكسرش أي مسار (شوف lib/analytics.ts).
        "analytics_engine_datasets": [
                {
                        "binding": "STORE_ANALYTICS",
                        "dataset": "laclarc_events",
                },
        ],
        // ─── طابور إعادة التوليد (DO) — ضروري للـ revalidate الزمني 86400 ───
        "durable_objects": {
                "bindings": [
                        {
                                "name": "NEXT_CACHE_DO_QUEUE",
                                "class_name": "DOQueueHandler",
                        },
                ],
        },
        "migrations": [
                {
                        "tag": "v1",
                        "new_sqlite_classes": [
                                "DOQueueHandler"
                        ],
                },
        ],
        // ─── متغيرات البيئة (غير السرّات! السرّات بـ wrangler secret put) ───
        "vars": {
                // الباك يبقى على Render كما هو — الفرونت كيهضر معاه HTTPS
                "NEXT_PUBLIC_API_URL": "https://api.laclarc.com",
                // 🩹 F110 api-unloop: الـ backend الحقيقي للـ proxy — runtime override
                // (ماشي NEXT_PUBLIC باش ما يتخبش فالبيلد) — default آمن ضد الحلقة
                "PB_BACKEND_URL": "",
                // NextAuth خلف بروكسي (Workers) — بلا هادا Google login كيفشل
                "AUTH_TRUST_HOST": "true",
        },
        // ─── تحسين الصور (مستقبلي — اليوم images.unoptimized:true فـ next.config) ───
        "images": {
                "binding": "IMAGES",
        },
        // ─── 🆕 phase-abc — الكرونات الثلاثة (البند 8) — كلها فالـ worker بوحدو ───
        //   0 3 * * *   → بناء الـ feeds يومياً (merchant-feed.xml + -usd.xml → R2)
        //   0 */6 * * * → runDailyPriceSync(25) — تزامن الأسعار/الستوك مع CJ (دورة عادلة)
        //   0 * * * *   → sweeper — إلغاء الطلبات الميتة (Stripe/Crypto/Paysera >2h · BaridiMob >48h)
        "triggers": {
                "crons": ["0 3 * * *", "0 */6 * * *", "0 * * * *"],
        },
}
