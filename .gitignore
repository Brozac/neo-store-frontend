# ═══════════════════════════════════════════════════════
# Laclarc Frontend — .gitignore v2 (Node.js + Next.js + Python)
# المبدأ: لا build artifacts · لا backups · لا runtime state
# ═══════════════════════════════════════════════════════

# ─── Dependencies ───
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.yarn/install-state.gz

# ─── Testing ───
/coverage

# ─── Next.js ───
/.next/
/out/
next-env.d.ts

# ─── Production ───
/build

# ─── 🔐 Secrets (حتى باسم مختلف) ───
.env*
!.env.example
!.env.oauth_template
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials*.json
serviceAccountKey*.json

# ─── Misc (v1) ───
.DS_Store
*.bak-xchg

# ─── 🩹 v2 — Backups (laclarc جراحة المحتوى ×10) ───
*.bak
*.bak2
*.bak_*
*.bak-*
*.bak-xchg
*.orig
*~
*.patch

# ─── 🩹 v2 — Temp / Cache (python-inject · debug) ───
*.tmp
*.swp
*.swo
*.swn
.cache/
.eslintcache
.tmp/

# ─── 🩹 v2 — Local diagnostic scripts (TSX & Python) ───
test_*.tsx
fix_*.tsx
probe_*.tsx
*_probe.tsx
debug_*.tsx
category_report*.tsx
test_*.py
fix_*.py
probe_*.py
*_probe.py
debug_*.py
category_report*.py

# ─── 🐍 Python Rules (تجاهل ملفات وبيئات بايثون) ───
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# CPython / Distribution artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
venv.*/
.env/

# Python Testing & Linters cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python Local DBs / State
*.sqlite3
*.db
*.log

# ─── 🩹 v2 — Runtime state (sessionStorage mirrors) ───
*.state.json
*.state.json.tmp

# ─── 🩹 v2 — Reports (local diagnostics) ───
*report*.json
*report*.txt
*report*.log

# ─── 🩹 v2 — OS junk (إضافات) ───
Thumbs.db
desktop.ini
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ─── 🩹 v2 — Editors (إضافات) ───
.idea/
.vscode/
.vs/
*.swp
*.swo
*.swn
.idea.xml

# ─── 🩹 v2 — Vercel (إضافات) ───
.vercel
.vercel/*
!.vercel/README.md
.vercel/project.json

# ─── 🩹 v2 — Node internals (إضافات) ───
.npm/
.node_repl_history
.node_repl_history.*
.eslintcache

# ─── 🩹 v2 — Storybook (إن وجد) ───
storybook-static/

# ─── 🩹 v2 — Next.js misc (إضافات) ───
next-env.d.ts.bak
.npmrc
*.tsbuildinfo

# ─── 🩹 v2 — Sentry (إن كان مفعلاً) ───
.sentryclirc